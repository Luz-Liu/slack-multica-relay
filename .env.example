# Slack App 与准入范围。白名单支持 all；黑名单优先于白名单。
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_TARGET_USER_IDS=
SLACK_TARGET_SUBTEAM_IDS=
# Optional Bot targets. When set, Bot mentions require the separate sender allowlist below.
SLACK_BOT_USER_IDS=
SLACK_BOT_ALLOWED_SENDER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=all
SLACK_BLOCKED_CHANNEL_IDS=
SLACK_ALLOWED_SENDER_IDS=all
SLACK_BLOCKED_SENDER_IDS=
# Slack App Bot token: used for users.info author lookup (users:read) and early reaction (reactions:write); use the receiving App.
SLACK_REACTION_TOKEN=
# Reaction added before queue dispatch; leave empty to use eyes.
SLACK_REACTION_NAME=eyes

# 普通 Multica Issue API；无需 Autopilot 或 Webhook。
MULTICA_API_BASE_URL=https://multica.example.com
MULTICA_API_TOKEN=
MULTICA_WORKSPACE_ID=
MULTICA_PROJECT_ID=
# 旧版 Agent 配置仍兼容；Team 模式使用下面的 TYPE/ID。
MULTICA_AGENT_ID=
MULTICA_ASSIGNEE_TYPE=agent
MULTICA_ASSIGNEE_ID=
# 已有项目迁移时固定为旧 MULTICA_AGENT_ID，永久保留，防止重复建卡。
MULTICA_THREAD_SCOPE_ID=
# 迁移过渡期允许原 Agent 归属；必须与 THREAD_SCOPE_ID 一致。
MULTICA_LEGACY_AGENT_ID=

# 本项目专用 Redis：线程映射和写入确认状态，默认保留90天。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# QStash：持久化收件、后台投递、重试与失败保留。
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# 必须是当前部署公开的准确 URL，供发送和验签共同使用。
RELAY_CONSUMER_URL=https://relay.example.com/api/queue/consume
